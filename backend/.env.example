# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=keyles
DB_USER=keyles
DB_PASSWORD=keyles_dev_password
DB_SSL_MODE=disable

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Email Service (Brevo)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@keyles.com
BREVO_SENDER_NAME=Keyles SSO

# JWT Configuration
JWT_SECRET=your_jwt_secret_change_in_production_minimum_32_characters
JWT_EXPIRATION_HOURS=24

# Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
GIN_MODE=debug

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization

# Rate Limiting
RATE_LIMIT_OTP_REQUESTS_PER_HOUR=3
RATE_LIMIT_OTP_ATTEMPTS_PER_OTP=5
RATE_LIMIT_LOGIN_ATTEMPTS_PER_15MIN=5

# OTP Configuration
OTP_EXPIRATION_MINUTES=10
OTP_LENGTH=6

# Application
APP_ENV=development
LOG_LEVEL=debug
