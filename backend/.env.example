# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=keyles
DB_USER=keyles
DB_PASSWORD=keyles_dev_password
DB_SSL_MODE=disable

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Email Service (Brevo)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@keyles.com
BREVO_SENDER_NAME=Keyles SSO

# JWT Configuration
JWT_SECRET=your_jwt_secret_change_in_production_minimum_32_characters
JWT_EXPIRATION_HOURS=24

# OAuth/OIDC Configuration
OAUTH_ISSUER=http://localhost:8080
OAUTH_ACCESS_TOKEN_TTL=900          # 15 minutes in seconds
OAUTH_REFRESH_TOKEN_TTL=604800      # 7 days in seconds
OAUTH_AUTH_CODE_TTL=300             # 5 minutes in seconds

# JWT Signing Keys (for OAuth tokens)
JWT_SIGNING_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_KEY_ID=dev_key_001

# Security Configuration
SECURITY_COOKIE_DOMAIN=localhost
SECURITY_COOKIE_SECURE=false        # Set to true in production (HTTPS only)
SECURITY_SESSION_TTL=28800          # 8 hours in seconds

# Rate Limiting (OAuth-specific)
RATE_LIMIT_TOKEN_ENDPOINT=10        # requests per minute per client_id
RATE_LIMIT_OTP_REQUESTS_PER_HOUR=3
RATE_LIMIT_OTP_ATTEMPTS_PER_OTP=5
RATE_LIMIT_LOGIN_ATTEMPTS_PER_15MIN=5

# Server Configuration
SERVER_PORT=8080
SERVER_HOST=0.0.0.0
GIN_MODE=debug

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization

# OTP Configuration
OTP_EXPIRATION_MINUTES=10
OTP_LENGTH=6

# Application
APP_ENV=development
LOG_LEVEL=debug
